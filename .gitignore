# Exclude these files from the git repo
.sass-cache/
edac_log.txt
#composer.lock
package-lock.json

# Hidden system files
*.DS_Store
*[Tt]humbs.db
*.Trashes
prepros-6.config
vendor
node_modules
build
dist
.env

#accessibility-checker-wp-env
.auth


.phpunit.result.cache

# Exclude coverage reports
coverage/

# Playwright artifacts — npm run test:e2e's outputDir resolves relative to the
# repo root (the cwd it's invoked from), not tests/e2e/, so these are separate
# from tests/e2e/.gitignore rather than redundant with it.
/test-results/
/playwright-report/
/blob-report/

# Local only working fules
*.log
*.sql
docs-local

# Claude Code (personal, not committed — .claude/settings.json is shared)
.claude/settings.local.json
.claude/worktrees/
